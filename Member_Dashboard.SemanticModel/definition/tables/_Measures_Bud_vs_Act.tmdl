table _Measures_Bud_vs_Act
	lineageTag: 7828781d-f9d7-4b93-acca-dd00b4ccfcfa

	measure 'Variance Favorable YTD' = ```
			
			( [Revenue Actual YTD] - [Revenue Budget YTD] )
			    + ( [Expense Budget YTD] - [Expense Actual YTD] )
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 50c9fec3-f98b-40dd-adec-602f3dc2e8de

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Spend vs Budget %' = DIVIDE ( [Expense Actual YTD], [Expense Budget YTD] )
		lineageTag: c1b87f95-1c74-489c-b613-fe5f5d662075

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue vs Budget %' = DIVIDE ( [Revenue Actual YTD], [Revenue Budget YTD] )
		lineageTag: b5d26a91-e093-41a5-b370-52040fdee2b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Full Year Budget Used %' = DIVIDE ( [Expense Actual YTD], [Expense Budget Full Year] )
		lineageTag: a784c8ef-bee8-451e-ab0d-9a6d8421f60a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Line Status' =
			
			VAR _a = [Actual YTD]
			VAR _b = [Budget YTD]
			VAR _type = SELECTEDVALUE ( DimAccount[Type] )
			RETURN
			    IF ( ISBLANK ( _b ) || _b = 0, BLANK (),
			        IF ( _type = "Revenue",
			            IF ( _a >= _b, "Above plan", "Below plan" ),
			            SWITCH ( TRUE (),
			                _a > _b * 1.05, "Over budget",
			                _a < _b * 0.95, "Under budget",
			                "On budget" ) ) )
		lineageTag: 294049c4-6ccc-4b1a-ae12-b7a73edd7e31

	column Column1
		dataType: string
		isHidden
		lineageTag: 51ceefdc-7394-4f56-9f88-40e2e0c9a252
		summarizeBy: none
		sourceColumn: Column1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures_Bud_vs_Act = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	changedProperty = Name

	annotation PBI_ResultType = Table


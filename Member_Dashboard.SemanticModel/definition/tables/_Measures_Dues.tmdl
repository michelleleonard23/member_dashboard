table _Measures_Dues
	lineageTag: 25350630-dad4-41d3-a354-28e7d3960f86

	measure 'Dues Revenue' = SUM ( FactDues[DuesRevenue] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 5873eb0d-755e-4236-9055-8c6fc9029843

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Dues Revenue YTD' = CALCULATE ( [Dues Revenue], DATESYTD ( DimDate[Date] ) )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: be0a1ce1-5121-4a04-8e43-c61404554fe1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Paying Members' = ```
			
			CALCULATE (
			    SUM ( FactDues[PayingMembers] ),
			    LASTNONBLANK ( DimDate[Date], CALCULATE ( SUM ( FactDues[PayingMembers] ) ) ) )
			
			```
		formatString: #,0
		lineageTag: b940105a-745b-44f9-92cd-0bd9046037a8

	measure 'Paying Members LY' = ```
			
			  VAR _last = CALCULATE ( MAX ( FactDues[MonthStart] ) )
			  RETURN
			      CALCULATE (
			          SUM ( FactDues[PayingMembers] ),
			          REMOVEFILTERS ( DimDate ),
			          DimDate[Date] = EDATE ( _last, -12 ) )
			```
		formatString: 0
		lineageTag: 6be8d9e0-1341-48af-9744-ce43f9844fd3

	measure 'Member Growth YoY %' = DIVIDE ( [Paying Members] - [Paying Members LY], [Paying Members LY] )
		lineageTag: 4177957e-dcc3-42b0-9188-1106c53a85c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New Members' = SUM ( FactDues[NewMembers] )
		formatString: 0
		lineageTag: 513bb21b-4101-4eaf-836d-123f8183be09

	measure 'Lapsed Members' = SUM ( FactDues[LapsedMembers] )
		formatString: 0
		lineageTag: 1916e990-dcf9-40bc-ac0e-ef12b2650d9d

	measure 'Net Member Change' = [New Members] - [Lapsed Members]
		formatString: 0
		lineageTag: dbbfb529-315e-42ac-ad7e-90b9bbd6cd0f

	measure 'Avg Dues per Member per Month' = DIVIDE ( [Dues Revenue], SUM ( FactDues[PayingMembers] ) )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 3117c29f-74a4-4e63-b036-a64f378b33ca

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Monthly Lapse Rate' = DIVIDE ( [Lapsed Members], SUM ( FactDues[PayingMembers] ) )
		lineageTag: e840c35e-6816-474c-90c3-7afd0ef40fa1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dues Share of Revenue' = DIVIDE ( [Dues Revenue YTD], [Revenue Actual YTD] )
		lineageTag: 9b15dd9a-daf4-4edf-80ea-98ff25ec83ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column1

table _Measures_Chapters
	lineageTag: a7133dd7-0c18-40a1-8232-3b79fe6f0fe7

	measure 'Dues Share Paid' = SUM ( FactChapterDuesShare[DuesShareAmount] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 98588dec-5602-4bef-8477-970a4787f7f8

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Chapter Grants Paid' = SUM ( FactChapterDuesShare[GrantAmount] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b3498a0a-f2e1-4ad9-bebd-82f412b4d85f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total to Chapters' = [Dues Share Paid] + [Chapter Grants Paid]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: ce5df584-2870-45f7-be41-594430464035

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total to Chapters YTD' = CALCULATE ( [Total to Chapters], DATESYTD ( DimDate[Date] ) )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 1359bf50-d0e6-4810-adc9-731651845aa9

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Chapter Members' = ```
			
			CALCULATE (
			    SUM ( FactChapterDuesShare[MembersInGoodStanding] ),
			    LASTNONBLANK ( DimDate[Date], CALCULATE ( SUM ( FactChapterDuesShare[MembersInGoodStanding] ) ) ) )
			
			```
		formatString: 0
		lineageTag: 0eebd583-36de-4375-8f40-4dcd88003ddd

	measure 'Dues Share per Member per Quarter' = ```
			
			DIVIDE ( [Dues Share Paid], SUM ( FactChapterDuesShare[MembersInGoodStanding] ) )
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b1ec36b7-e3e9-475a-b9e4-88d46284cd8e

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Chapters Receiving Grants' = ```
			
			CALCULATE ( DISTINCTCOUNT ( FactChapterDuesShare[ChapterID] ), FactChapterDuesShare[GrantAmount] > 0 )
			
			```
		formatString: 0
		lineageTag: 06d8cc53-1cf7-4c3e-be95-aa9e780421ef

	measure 'Share of Dues Returned to Chapters' = DIVIDE ( [Total to Chapters YTD], [Dues Revenue YTD] )
		lineageTag: 14ba0c77-c6db-4c57-9a66-9cf643d1ea53

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column1

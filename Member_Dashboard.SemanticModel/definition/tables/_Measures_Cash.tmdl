table _Measures_Cash
	lineageTag: f0564397-99b3-4d9b-892e-7a9f70266106

	measure 'Cash Balance' = ```
			
			CALCULATE (
			    SUM ( FactCash[EndingBalance] ),
			    LASTNONBLANK ( DimDate[Date], CALCULATE ( SUM ( FactCash[EndingBalance] ) ) ) )
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 4ff9f323-26c1-4332-bd87-e1ad2d7395c6

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Unrestricted Cash' = CALCULATE ( [Cash Balance], FactCash[Fund] <> "Restricted" )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c3dbc18c-f219-476a-87eb-e20223489ada

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Reserve Balance' = CALCULATE ( [Cash Balance], FactCash[Fund] = "Board-Designated Reserve" )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 3a83e432-3c25-47fc-bcc6-c65e45847072

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Monthly Expenses T12' = ```
			
			VAR _end = EOMONTH ( MIN ( MAX ( DimDate[Date] ), [Last Closed Month] ), 0 )
			RETURN
			    DIVIDE (
			        CALCULATE ( [Expense Actual], DATESINPERIOD ( DimDate[Date], _end, -12, MONTH ) ),
			        12 )
			
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: a13cf77b-0754-4ea8-8347-a6c28503f8af

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Months of Reserves' = ```
			DIVIDE ( [Reserve Balance], [Avg Monthly Expenses T12] )
			
			```
		lineageTag: f6859ba7-fb8b-492e-8ac1-59d222fa9cc5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Months of Unrestricted Cash' = DIVIDE ( [Unrestricted Cash], [Avg Monthly Expenses T12] )
		lineageTag: b96220aa-57fc-4bc0-a24b-d26c0d7d16ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reserve Target Months' = MAX ( Settings[ReserveTargetMonths] )
		formatString: 0
		lineageTag: be637058-d6e6-467d-bca9-46b05ac73719

	measure 'Reserve Target $' = [Avg Monthly Expenses T12] * [Reserve Target Months]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 6a47f3d4-f1b5-4dcf-88b4-01c88c3a37a8

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Reserve Gap $' = MAX ( 0, [Reserve Target $] - [Reserve Balance] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f2eeb9ca-d4b2-4322-b89f-e466595cffc6

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Reserve Status' = ```
			
			VAR _m = [Months of Reserves]
			VAR _t = [Reserve Target Months]
			RETURN
			    SWITCH ( TRUE (),
			        _m >= _t, "Meets target",
			        _m >= _t * 0.5, "Below target",
			        "Well below target" )
			
			```
		lineageTag: 2bfc9282-df21-4098-8999-109712613a4f

	measure 'Restricted Funds' = CALCULATE ( [Cash Balance], FactCash[Fund] = "Restricted" )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b1e6d757-76f4-48e5-966b-3b3a8af246b0

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column Column1
		dataType: string
